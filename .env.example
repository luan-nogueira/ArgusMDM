# Copie este arquivo para ".env" (mesmo diretório do docker-compose.yml) e preencha
# os valores antes de rodar `docker compose up -d`. Nunca commite o ".env" de verdade.

# --- Banco de dados ---
DB_NAME=mdm_db
DB_USER=mdm_user
DB_PASSWORD=troque-esta-senha

# --- Segurança ---
# Gere uma string aleatória longa, ex: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-uma-string-aleatoria-de-pelo-menos-32-caracteres

# --- Admin inicial (criado automaticamente no primeiro start) ---
ADMIN_EMAIL=seu-email@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# --- CORS ---
# URL(s) do frontend que podem chamar a API, separadas por vírgula.
# Inclua a URL de produção do Vercel assim que fizer o primeiro deploy.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://seu-projeto.vercel.app

# --- Cloudflare Tunnel ---
# Token gerado ao criar o túnel em https://one.dash.cloudflare.com > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=

# --- Evolution API (WhatsApp Gateway Oficial) ---
EVOLUTION_API_KEY=argus_mdm_secret_key_2026
EVOLUTION_SERVER_URL=http://localhost:8081

# --- Firebase Cloud Messaging (opcional) ---
FIREBASE_ENABLED=false
